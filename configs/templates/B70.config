# ============================================================
# 极路由 4 增强版 (B70 / HC5962) Padavan 固件编译配置
# 内置：aria2 (编译) + PHP 探针 (编译)
# 外挂：ShellClash (常开) + Tailscale (按需) + aria2-WebUI (按需)
# 目标仓库: https://github.com/chenxudong2020/Padavan-build
# 衍生源:  https://github.com/bishiping/padavan-4.4  (kernel 4.4)
#           或 https://github.com/hanwckf/rt-n56u       (kernel 3.4)
# ============================================================

# ---- 设备识别 ----
CONFIG_FIRMWARE_PRODUCT_NAME="B70"
CONFIG_FIRMWARE_VERSION="3.4.3.9"
CONFIG_HOSTNAME="HiWiFi-B70"
CONFIG_USER_PROVIDED_VERSION="padavan-b70-shellclash"

# ---- 平台 / 无线 ----
CONFIG_RALINK_MT7621=y
CONFIG_MT76X2_AP=y
CONFIG_MT7603E_AP=y
CONFIG_IFNAME="ra0 rai0"
CONFIG_2G_DRIVER="MT7603E"
CONFIG_5G_DRIVER="MT76X2"
CONFIG_RT_FIRST_MBSS="0"
CONFIG_RT_SECOND_MBSS="1"
CONFIG_IC_CHECK_PING=y

# ---- 网络 ----
CONFIG_IPV6=y
CONFIG_FIRMWARE_IPV6_SUPPORT=y
CONFIG_FIRMWARE_NAT46_CL=y
CONFIG_FIRMWARE_FULLCONE=y
CONFIG_FIRMWARE_QCA_HWNAT=y
CONFIG_FIRMWARE_RA_HWNAT=y
CONFIG_FIRMWARE_REPEATER=y

# ---- 内置插件 (Y 才会真正进 firmware 分区) ----
CONFIG_FIRMWARE_INCLUDE_ARIA2=y
CONFIG_FIRMWARE_INCLUDE_PHP=y
CONFIG_FIRMWARE_INCLUDE_PHP_PROBE=y

# 内置下载插件相关辅助
CONFIG_FIRMWARE_INCLUDE_YT_DLP=y

# 不要的（你笔记说的"这几页都不要"——我把它们全关掉）
# CONFIG_FIRMWARE_INCLUDE_SMARTDNS=n
# CONFIG_FIRMWARE_INCLUDE_ADGUARDHOME=n
# CONFIG_FIRMWARE_INCLUDE_SOFTETHERVPN=n
# CONFIG_FIRMWARE_INCLUDE_DDNS=y            # 不强制，留默认
# CONFIG_FIRMWARE_INCLUDE_SAMBA_SERVER=n   # samba/媒体服务都不要
# CONFIG_FIRMWARE_INCLUDE_FTP_SERVER=n

# ---- Web UI ----
CONFIG_FIRMWARE_LOGIN_NAME="admin"
CONFIG_FIRMWARE_LOGIN_PASSWORD="admin"

# ---- 二进制注入 (大小不超 256 KB 的内置) ----
# ShellClash / Tailscale 体积太大，**不**走这里，改由 /etc/storage/startup.sh 首次启动时拉取
# CONFIG_FIRMWARE_INCLUDE_SHELLCLASH=n
# CONFIG_FIRMWARE_INCLUDE_TAILSCALE=n
# CONFIG_FIRMWARE_INCLUDE_SINGBOX=n
